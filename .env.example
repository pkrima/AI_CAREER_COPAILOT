# Google Gemini API Key (Free tier available at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Alternatively, OpenAI API Key
# OPENAI_API_KEY=

# Set DEMO_MODE=true to test without any external API key
# DEMO_MODE=false

FLASK_SECRET_KEY=

# Optional TiDB Cloud connection. Set all values to use TiDB instead of local SQLite.
# TIDB_HOST=
TIDB_USERNAME=
TIDB_PASSWORD=
TIDB_DATABASE=test
TIDB_PORT=4000
TIDB_CA_PATH=C:/certs/isrgrootx1.pem

# Alternatively, set a complete SQLAlchemy URL:
# DATABASE_URL=
